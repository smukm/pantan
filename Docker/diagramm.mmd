flowchart TB
    subgraph Пользователи
        USER([👤 Пользователь])
    end

    subgraph Внешние системы
        SITE[🌐 brend-logo.ru:443<br/>Сайт с метриками]
    end

    subgraph "Docker Compose Stack"
        subgraph "Основной сервис"
            PANTAN[🔧 pantan<br/>PT_PORT]
        end

        subgraph "Мониторинг - Prometheus Stack"
            PROMETHEUS[📊 Prometheus<br/>:9090<br/>Сбор метрик]
            NODE_EXPORTER[📈 Node Exporter<br/>:9100<br/>Системные метрики]
            GRAFANA[📉 Grafana<br/>:3000<br/>Визуализация]
        end

        subgraph "Логирование - Loki Stack"
            LOKI[📝 Loki<br/>:3100<br/>Хранилище логов]
            PROMTAIL[🔍 Promtail<br/>:9080<br/>Сбор логов]
        end

        subgraph "Тома данных"
            VOL_PROM[(prometheus-data)]
            VOL_GRAF[(grafana-data)]
            VOL_LOKI[(loki-data)]
            VOL_LOGS[📁 /logs/brend-logo<br/>Логи сайта<br/>из /var/www/...]
        end
    end

    %% Связи сбора метрик
    PROMETHEUS -->|"scrape"| PANTAN
    PROMETHEUS -->|"scrape"| PROMETHEUS
    PROMETHEUS -->|"scrape"| NODE_EXPORTER
    PROMETHEUS -->|"scrape<br/>HTTPS"| SITE

    %% Связи логирования
    PROMTAIL -->|"push logs"| LOKI
    VOL_LOGS -->|"read files"| PROMTAIL

    %% Связи визуализации
    GRAFANA -->|"query"| PROMETHEUS
    GRAFANA -->|"query"| LOKI

    %% Связи пользователей
    USER -->|"http://host:3000"| GRAFANA
    USER -.->|"опционально<br/>http://host:9090"| PROMETHEUS

    %% Связи с томами
    PROMETHEUS ---|"read/write"| VOL_PROM
    GRAFANA ---|"read/write"| VOL_GRAF
    LOKI ---|"read/write"| VOL_LOKI

